      {
        "name": "Verificar password",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst d = $('Validar datos login').first().json;\nconst usuarios = $('Leer usuarios').all().map(i => i.json).filter(u => u.usuario_id);\nconst u = usuarios.find(x => x.email_normalizado === d.email);\nconst fallo = { ok: false, error_status: 401, error_codigo: 'CREDENCIALES', error_mensaje: 'Correo o contraseña incorrectos.' };\nif (!u) return [{ json: fallo }];\n\n// mismo calculo que en el registro: pbkdf2 con la sal del usuario\nconst hash = crypto.pbkdf2Sync(d.password, String(u.password_salt), 100000, 32, 'sha256').toString('hex');\nconst guardado = String(u.password_hash);\nconst iguales = hash.length === guardado.length &&\n  crypto.timingSafeEqual(Buffer.from(hash, 'hex'), Buffer.from(guardado, 'hex'));\nif (!iguales) return [{ json: fallo }];\n\nif (u.estado !== 'ACTIVO') {\n  return [{ json: { ok: false, error_status: 403, error_codigo: 'USUARIO_INACTIVO', error_mensaje: 'Tu cuenta está desactivada.' } }];\n}\nreturn [{ json: { ok: true, usuario: { usuario_id: u.usuario_id, nombre: u.nombre, email: u.email_normalizado } } }];\n"
        },
        "id": "3620e0b5-9d06-4dd9-b434-70333c746ed6",
