      {
        "name": "Crear token de sesión",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const crypto = require('crypto');\nconst u = $input.first().json.usuario;\nconst horaCO = (ms) => new Date(ms - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nconst ahora = Date.now();\nconst HORAS_SESION = 8;\nreturn [{\n  json: {\n    session_id: 'SES-' + ahora.toString(36).toUpperCase() + crypto.randomBytes(2).toString('hex').toUpperCase(),\n    usuario_id: u.usuario_id,\n    session_token: crypto.randomBytes(24).toString('hex'),\n    creada_en: horaCO(ahora),\n    expira_en: horaCO(ahora + HORAS_SESION * 3600 * 1000),\n    estado: 'ACTIVA',\n    cerrada_en: '',\n    ultima_validacion: horaCO(ahora),\n  },\n}];\n"
        },
