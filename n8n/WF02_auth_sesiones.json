      {
        "name": "Validar datos login",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const d = $input.first().json;\nconst emailOk = d.email.length <= 120 && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(d.email);\nif (!emailOk || !d.password) {\n  return [{ json: { ...d, valido: false, error_status: 400, error_codigo: 'DATOS_INCOMPLETOS', error_mensaje: 'Escribe un correo válido y tu contraseña.' } }];\n}\nreturn [{ json: { ...d, valido: true } }];\n"
        },
