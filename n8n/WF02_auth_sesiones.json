          "jsCode": "// una sesion NO es valida si: no existe, esta cerrada, expiro o el usuario esta inactivo\nconst token = String($('Al ser llamado (validar sesión)').first().json.token || '').trim();\nconst ahoraMs = Date.now();\nconst ahora = new Date(ahoraMs - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nconst sesiones = $('Leer sesiones').all().map(i => i.json).filter(s => s.session_id);\nconst usuarios = $('Leer usuarios (validación)').all().map(i => i.json).filter(u => u.usuario_id);\n\nlet r = { valida: false, motivo: 'NO_EXISTE', actualizar: false };\nconst s = token ? sesiones.find(x => x.session_token === token) : null;\nif (s) {\n  const u = usuarios.find(x => x.usuario_id === s.usuario_id);\n  if (s.estado === 'CERRADA') {\n    r.motivo = 'CERRADA';\n  } else if (s.estado === 'EXPIRADA') {\n    r.motivo = 'EXPIRADA';\n  } else if (new Date(s.expira_en).getTime() <= ahoraMs) {\n    r = { valida: false, motivo: 'EXPIRADA', actualizar: true, session_id: s.session_id, estado: 'EXPIRADA', ultima_validacion: ahora };\n  } else if (!u || u.estado !== 'ACTIVO') {\n    r.motivo = 'USUARIO_INACTIVO';\n  } else {\n    r = {\n      valida: true, motivo: 'OK', actualizar: true,\n      session_id: s.session_id, estado: 'ACTIVA', ultima_validacion: ahora,\n      usuario: { usuario_id: u.usuario_id, nombre: u.nombre, email: u.email_normalizado },\n    };\n  }\n}\nreturn [{ json: r }];\n"
        },
