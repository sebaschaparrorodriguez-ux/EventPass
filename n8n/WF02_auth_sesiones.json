      {
        "name": "Cerrar sesión",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const token = $('Normalizar solicitud').first().json.token;\nconst sesiones = $('Leer sesiones (logout)').all().map(i => i.json).filter(s => s.session_id);\nconst s = token ? sesiones.find(x => x.session_token === token) : null;\nif (!s || s.estado !== 'ACTIVA') return [{ json: { cerrar: false } }];\nconst ahora = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nreturn [{ json: { cerrar: true, session_id: s.session_id, estado: 'CERRADA', cerrada_en: ahora } }];\n"
