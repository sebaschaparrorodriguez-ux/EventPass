      {
        "name": "Validar entrada",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const d = $input.first().json;\nconst faltan = ['usuario_id', 'tipo', 'titulo', 'mensaje'].filter(k => !d[k]);\n// la clave evita mandar dos veces lo mismo si un flujo se reintenta\nconst clave = [d.tipo, d.usuario_id, d.evento_id || '', d.inscripcion_id || '', d.clave_extra || ''].join('|');\nreturn [{\n  json: {\n    valida: faltan.length === 0,\n    error: faltan.length ? 'Faltan campos: ' + faltan.join(', ') : '',\n    usuario_id: String(d.usuario_id || ''),\n    tipo: String(d.tipo || ''),\n    titulo: String(d.titulo || ''),\n    mensaje: String(d.mensaje || ''),\n    evento_id: String(d.evento_id || ''),\n    inscripcion_id: String(d.inscripcion_id || ''),\n    clave_idempotencia: clave,\n  },\n}];\n"
        },
        "id": "4e5ef744-67ce-4199-95be-18b0f4c54d23",
        "position": [
          240,
          0
        ]
