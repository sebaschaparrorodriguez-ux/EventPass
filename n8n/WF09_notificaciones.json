      {
        "name": "Armar registro",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const d = $input.first().json;\nreturn [{\n  json: {\n    notificacion_id: 'NOT-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 4).toUpperCase(),\n    usuario_id: d.usuario_id,\n    tipo: d.tipo,\n    titulo: d.titulo,\n    mensaje: d.mensaje,\n    evento_id: d.evento_id,\n    inscripcion_id: d.inscripcion_id,\n    fecha: new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00',\n    gmail_estado: d.gmail_estado,\n    telegram_estado: d.telegram_estado,\n    gmail_error: d.gmail_error || '',\n    telegram_error: d.telegram_error || '',\n    clave_idempotencia: d.clave_idempotencia,\n  },\n}];\n"
