      {
        "name": "Preparar mensaje",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const d = $('Validar entrada').first().json;\n    const u = $('Leer usuario').all().map(i => i.json).find(x => x.usuario_id === d.usuario_id) || {};\n    const v = $('Leer chat_id').all().map(i => i.json).find(x => x.usuario_id === d.usuario_id && x.estado === 'ACTIVA');\n    const yaEnviada = $('Leer notificaciones').all().map(i => i.json)\n      .some(x => x.clave_idempotencia === d.clave_idempotencia && (x.gmail_estado === 'ENVIADO' || x.telegram_estado === 'ENVIADO'));\n\n    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n    const nombre = (u.nombre || 'vecino').split(' ')[0];\n    const email = u.email_normalizado || '';\n    // los usuarios de prueba usan example.com, a esos no se les manda correo\n    const correoDePrueba = /@example\\.(com|org|net)$/i.test(email);\n    // respetamos los canales que la persona escogio en su perfil (vacio = SI).\n    // la bienvenida siempre va por correo porque es la confirmacion del registro\n    const quiereCorreo = u.avisos_email !== 'NO' || d.tipo === 'CUENTA_CREADA';\n    const quiereTelegram = u.avisos_telegram !== 'NO';\n\n    const html = `\n<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:540px;margin:0 auto;border-radius:14px;overflow:hidden;border:1px solid #e7dfd1\">\n  <div style=\"background:#14213d;color:#fff4d6;padding:16px 22px;font-size:20px;font-weight:bold;border-bottom:4px solid #b3262e\">EventPass <span style=\"color:#e8b04b\">Barrio</span></div>\n  <div style=\"padding:22px;background:#fbf7ef;color:#1d1a17;line-height:1.5\">\n    <h2 style=\"margin:0 0 12px\">${esc(d.titulo)}</h2>\n    <p>Hola ${esc(nombre)},</p>\n    <p>${esc(d.mensaje)}</p>\n    <p style=\"color:#5f5850;font-size:13px;margin-top:24px\">Este aviso también te llegó por Telegram si tienes la cuenta vinculada. ¡Feliz Navidad, vecino!</p>\n  </div>\n</div>`.trim();\n\n    return [{\n      json: {\n        ...d,\n        ya_enviada: yaEnviada,\n        email: correoDePrueba || !quiereCorreo ? '' : email,\n        chat_id: v && quiereTelegram ? String(v.chat_id) : '',\n        html,\n        texto_telegram: `<b>${esc(d.titulo)}</b>\\n\\n${esc(d.mensaje)}`,\n      },\n    }];\n"
        },
        "id": "d390b955-eaf0-49cb-becd-7c30c0af671c",
        "position": [
          1440,
          0
        ]
