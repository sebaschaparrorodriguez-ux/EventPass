      {
        "name": "Registrar consulta",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const p = $('Leer parámetros').first().json;\nconst r = $('Calcular cupos').first().json;\nreturn [{\n  json: {\n    consulta_id: 'CON-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase(),\n    fecha: new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00',\n    tipo: p.tipo,\n    evento_id: p.evento_id,\n    categoria: p.categoria,\n    resultado_count: r._count,\n    visitor_id: p.visitor_id,\n    status_http: r.status,\n  },\n}];\n"
        },
        "id": "5a08c0a3-534a-465b-a102-2a28aa42ae95",
