        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const q = $input.first().json.query || {};\nlet tipo = String(q.tipo || 'LISTADO').toUpperCase();\nif (!['LISTADO', 'DETALLE', 'FILTRO'].includes(tipo)) tipo = 'LISTADO';\nreturn [{\n  json: {\n    tipo,\n    categoria: String(q.categoria || '').trim(),\n    evento_id: String(q.evento_id || '').trim().toUpperCase(),\n    visitor_id: String(q.visitor_id || 'ANONIMO').slice(0, 40),\n  },\n}];\n"
        },
