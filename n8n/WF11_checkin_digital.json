      {
        "name": "Validar check-in",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const d = $('Normalizar solicitud').first().json;\nconst sesion = $('Validar sesión (WF02)').first().json;\nconst ahoraMs = Date.now();\nconst ahora = new Date(ahoraMs - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\n\nconst ins = $('Leer inscripción').all().map(i => i.json).find(i => i.inscripcion_id === d.inscripcion_id);\nconst ev = $('Leer evento').all().map(i => i.json).find(e => e.evento_id === d.evento_id);\nconst historial = $('Leer historial de check-in').all().map(i => i.json).filter(c => c.checkin_id);\nconst previo = historial.find(c => c.inscripcion_id === d.inscripcion_id && c.resultado === 'EXITOSO');\nconst u = ins ? $('Leer asistente').all().map(i => i.json).find(x => x.usuario_id === ins.usuario_id) : null;\nconst quien = sesion.valida ? sesion.usuario.usuario_id : 'sin sesión';\n\n// cada intento queda registrado en EP11, salga bien o mal\nconst registro = (resultado, status, mensaje, detalle) => [{\n  json: {\n    checkin_id: 'CHK-' + ahoraMs.toString(36).toUpperCase() + Math.random().toString(36).slice(2, 4).toUpperCase(),\n    inscripcion_id: d.inscripcion_id,\n    evento_id: d.evento_id,\n    usuario_id: ins ? ins.usuario_id : '',\n    fecha_checkin: ahora,\n    resultado,\n    detalle: `${detalle} · registró: ${quien}`,\n    _status: status,\n    _mensaje: mensaje,\n    _asistente: u ? { nombre: u.nombre, nombre_acreditacion: ins.nombre_acreditacion } : null,\n    _evento: ev ? { nombre: ev.nombre, fecha: ev.fecha, hora: ev.hora, lugar: ev.lugar } : null,\n    _previo: previo ? previo.fecha_checkin : null,\n  },\n}];\n\nif (!sesion.valida) return registro('RECHAZADO', 401, 'Necesitas iniciar sesión para registrar ingresos.', `Sesión no válida (${sesion.motivo})`);\nif (!['SUPERVISOR', 'ADMINISTRADOR'].includes(sesion.usuario.rol)) {\n  return registro('RECHAZADO', 403, 'Solo supervisores y administradores pueden registrar ingresos.', `Sin permiso (rol ${sesion.usuario.rol})`);\n}\nif (!d.inscripcion_id || !d.evento_id) return registro('RECHAZADO', 400, 'Falta el código de inscripción o el evento.', 'Datos incompletos');\nif (!ins) return registro('RECHAZADO', 404, `La inscripción ${d.inscripcion_id} no existe.`, 'Inscripción inexistente');\nif (!ev) return registro('RECHAZADO', 404, `El evento ${d.evento_id} no existe.`, 'Evento inexistente');\nif (ins.evento_id !== ev.evento_id) {\n  return registro('RECHAZADO', 409, `Esta inscripción es de otro evento (${ins.evento_id}), no de ${ev.evento_id}.`, `Inscripción de otro evento (${ins.evento_id})`);\n}\n// idempotencia: va antes que el estado porque despues del primer ingreso queda en ASISTIO\nif (previo || ins.estado === 'ASISTIO') {\n  const cuando = previo ? previo.fecha_checkin.slice(11, 16) : '';\n  return registro('DUPLICADO', 409, `El ingreso ya había sido registrado${cuando ? ' a las ' + cuando : ''}.`, `Ya tenía check-in exitoso${previo ? ' (' + previo.checkin_id + ')' : ''}`);\n}\nif (ins.estado !== 'CONFIRMADA') {\n  const motivos = {\n    LISTA_ESPERA: 'La inscripción está en lista de espera, no tiene cupo confirmado.',\n    CANCELADA: 'La inscripción fue cancelada.',\n  };\n  return registro('RECHAZADO', 409, motivos[ins.estado] || `La inscripción está en estado ${ins.estado} y no permite el ingreso.`, `Estado ${ins.estado}`);\n}\nreturn registro('EXITOSO', 200, 'Check-in realizado correctamente.', 'Ingreso registrado');\n"
        },
