      {
        "name": "Normalizar formulario",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const f = $input.first().json;\nconst t = (k) => String(f[k] ?? '').trim();\nconst sinCambio = (v) => (v === '(sin cambio)' ? '' : v);\nreturn [{\n  json: {\n    accion: t('Acción'),\n    evento_id: t('ID del evento').toUpperCase(),\n    nombre: t('Nombre'),\n    categoria: sinCambio(t('Categoría')),\n    descripcion: t('Descripción'),\n    fecha: t('Fecha').slice(0, 10),\n    hora: t('Hora'),\n    lugar: t('Lugar'),\n    capacidad: t('Capacidad'),\n    imagen_url: t('URL de imagen'),\n    organizador: t('Organizador'),\n    estado: sinCambio(t('Estado')),\n    motivo: t('Motivo / nota'),\n  },\n}];\n"
        },
        "id": "f0a572b3-d938-4f33-94e5-d37ecc8031bb",
        "position": [
          240,
