        "typeVersion": 2,
        "parameters": {
          "jsCode": "// siempre devuelve algo para que el flujo llegue a la pagina final del formulario\nconst nadie = [{ json: { sin_avisos: true } }];\nconst v = $('Validar formulario').first().json;\nif (v.accion === 'CREAR') return nadie;\nconst importantes = ['fecha', 'hora', 'lugar'];\nconst cambioImportante = v.accion === 'ACTUALIZAR' && (v.cambiados || []).some(c => importantes.includes(c));\nif (v.accion !== 'CANCELAR' && !cambioImportante) return nadie;\n\nconst ev = v.evento;\nconst activas = $('Leer inscripciones').all().map(i => i.json)\n  .filter(i => i.evento_id === ev.evento_id && (i.estado === 'CONFIRMADA' || i.estado === 'LISTA_ESPERA'));\nif (!activas.length) return nadie;\n\nreturn activas.map(i => ({\n  json: v.accion === 'CANCELAR'\n    ? {\n      usuario_id: i.usuario_id, evento_id: ev.evento_id, inscripcion_id: i.inscripcion_id,\n      tipo: 'EVENTO_CANCELADO',\n      titulo: `Se canceló: ${ev.nombre}`,\n      mensaje: `Lo sentimos, el evento \"${ev.nombre}\" del ${ev.fecha} fue cancelado por los organizadores.${v.motivo ? ' Motivo: ' + v.motivo : ''}`,\n      clave_extra: v.fila.fecha_actualizacion,\n    }\n    : {\n      usuario_id: i.usuario_id, evento_id: ev.evento_id, inscripcion_id: i.inscripcion_id,\n      tipo: 'EVENTO_ACTUALIZADO',\n      titulo: `Cambios en: ${ev.nombre}`,\n      mensaje: `El evento \"${ev.nombre}\" cambió. Ahora es el ${ev.fecha} a las ${ev.hora} en ${ev.lugar}.${v.motivo ? ' Nota: ' + v.motivo : ''}`,\n      clave_extra: v.fila.fecha_actualizacion,\n    },\n}));\n"
        },
