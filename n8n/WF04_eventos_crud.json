      {
        "name": "Validar formulario",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const f = $('Normalizar formulario').first().json;\nconst eventos = $('Leer eventos').all().map(i => i.json).filter(e => e.evento_id);\nconst CATEGORIAS = ['Cultura', 'Deportes', 'Comunidad', 'Educación', 'Emprendimiento'];\nconst ahora = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nconst errores = [];\nconst fail = () => [{ json: { valido: false, accion: f.accion, errores } }];\n\nconst revisar = (e, parcial) => {\n  const req = (campo, nombre) => { if (!parcial && !e[campo]) errores.push(`Falta ${nombre}`); };\n  req('nombre', 'el nombre'); req('categoria', 'la categoría'); req('fecha', 'la fecha'); req('hora', 'la hora');\n  req('lugar', 'el lugar'); req('capacidad', 'la capacidad'); req('organizador', 'el organizador'); req('descripcion', 'la descripción');\n  if (e.categoria && !CATEGORIAS.includes(e.categoria)) errores.push('Categoría no válida');\n  if (e.fecha && !/^\\d{4}-\\d{2}-\\d{2}$/.test(e.fecha)) errores.push('La fecha debe ser AAAA-MM-DD');\n  if (e.hora && !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(e.hora)) errores.push('La hora debe ser HH:MM (24 horas)');\n  if (e.capacidad !== '' && e.capacidad !== undefined && (!Number.isInteger(Number(e.capacidad)) || Number(e.capacidad) <= 0)) errores.push('La capacidad debe ser un entero mayor a 0');\n  if (e.imagen_url && !/^(https?:\\/\\/|\\/)/.test(e.imagen_url)) errores.push('La URL de imagen debe empezar por http(s):// o /');\n};\n\nif (f.accion === 'CREAR') {\n  revisar(f, false);\n  if (f.estado === 'CERRADO') errores.push('Un evento nuevo solo puede quedar en BORRADOR o PUBLICADO');\n  if (errores.length) return fail();\n  const nums = eventos.map(e => parseInt(String(e.evento_id).replace(/\\D/g, ''), 10)).filter(x => !isNaN(x));\n  const sig = (nums.length ? Math.max(...nums) : 0) + 1;\n  const fila = {\n    evento_id: 'EVT-' + String(sig).padStart(4, '0'),\n    nombre: f.nombre, categoria: f.categoria, descripcion: f.descripcion, fecha: f.fecha, hora: f.hora,\n    lugar: f.lugar, capacidad: Number(f.capacidad), imagen_url: f.imagen_url, organizador: f.organizador,\n    estado: f.estado || 'BORRADOR', fecha_creacion: ahora, fecha_actualizacion: ahora,\n  };\n  return [{ json: { valido: true, accion: f.accion, fila, motivo: f.motivo, detalle: `Creado en estado ${fila.estado}` } }];\n}\n\nif (!f.evento_id) { errores.push('Escribe el ID del evento'); return fail(); }\nconst actual = eventos.find(e => e.evento_id === f.evento_id);\nif (!actual) { errores.push(`No existe el evento ${f.evento_id}`); return fail(); }\n\nif (f.accion === 'CONSULTAR') return [{ json: { valido: true, accion: f.accion, fila: actual } }];\n\nif (actual.estado === 'CANCELADO') { errores.push('El evento está CANCELADO y ya no se puede modificar'); return fail(); }\n\nif (f.accion === 'CANCELAR' || f.accion === 'CERRAR') {\n  const nuevo = f.accion === 'CANCELAR' ? 'CANCELADO' : 'CERRADO';\n  if (actual.estado === nuevo) { errores.push(`El evento ya está ${nuevo}`); return fail(); }\n  return [{\n    json: {\n      valido: true, accion: f.accion, motivo: f.motivo, estado_anterior: actual.estado,\n      fila: { evento_id: actual.evento_id, estado: nuevo, fecha_actualizacion: ahora },\n      evento: { ...actual, estado: nuevo },\n      detalle: `${actual.estado} -> ${nuevo}${f.motivo ? '. ' + f.motivo : ''}`,\n    },\n  }];\n}\n\nif (f.accion === 'ACTUALIZAR') {\n  revisar(f, true);\n  if (errores.length) return fail();\n  const campos = ['nombre', 'categoria', 'descripcion', 'fecha', 'hora', 'lugar', 'capacidad', 'imagen_url', 'organizador', 'estado'];\n  const fila = { evento_id: actual.evento_id };\n  const cambiados = [];\n  for (const c of campos) {\n    if (f[c] !== '' && String(f[c]) !== String(actual[c])) { fila[c] = c === 'capacidad' ? Number(f[c]) : f[c]; cambiados.push(c); }\n  }\n  if (!cambiados.length) { errores.push('No cambiaste ningún dato'); return fail(); }\n  fila.fecha_actualizacion = ahora;\n  return [{\n    json: {\n      valido: true, accion: f.accion, motivo: f.motivo, estado_anterior: actual.estado, fila, cambiados,\n      evento: { ...actual, ...fila },\n      detalle: 'Cambió: ' + cambiados.join(', '),\n    },\n  }];\n}\n\nerrores.push('Acción no reconocida');\nreturn fail();\n"
        },
        "id": "82894c91-f665-4896-b9fc-656a60ad599a",
