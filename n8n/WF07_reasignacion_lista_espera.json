        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "return $('Elegir promovidos').all().map(it => {\n  const p = it.json;\n  return {\n    json: {\n      usuario_id: p._usuario_id, evento_id: p._evento_id, inscripcion_id: p.inscripcion_id,\n      tipo: 'REASIGNACION_CUPO',\n      titulo: `¡Se liberó un cupo! ${p._evento_nombre}`,\n      mensaje: `Buenas noticias: se liberó un cupo en \"${p._evento_nombre}\" y era tuyo por orden de llegada. Tu inscripción pasó a CONFIRMADA. Te esperamos el ${p._fecha} a las ${p._hora} en ${p._lugar}.`,\n    },\n  };\n});\n"
