      {
        "name": "Registro de reasignación",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const promovidos = $('Elegir promovidos').all();\nconst notifs = $input.all();\nreturn promovidos.map((it, idx) => {\n  const p = it.json;\n  const r = (notifs[idx] && notifs[idx].json) || {};\n  return {\n    json: {\n      reasignacion_id: 'REA-' + Date.now().toString(36).toUpperCase() + idx,\n      evento_id: p._evento_id,\n      inscripcion_id: p.inscripcion_id,\n      usuario_id: p._usuario_id,\n      fecha: p.fecha_actualizacion,\n      orden_lista: p._orden_lista,\n      estado_anterior: 'LISTA_ESPERA',\n      estado_nuevo: 'CONFIRMADA',\n      resultado_notificacion: `GMAIL:${r.gmail_estado || 'SIN_DATO'} | TELEGRAM:${r.telegram_estado || 'SIN_DATO'}`,\n    },\n  };\n});\n"
        },
