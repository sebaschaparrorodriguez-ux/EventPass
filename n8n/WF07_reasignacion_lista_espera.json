      {
        "name": "Auditoría inscripción",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "return $('Elegir promovidos').all().map(it => ({\n  json: {\n    auditoria_id: 'AUD-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 5).toUpperCase(),\n    inscripcion_id: it.json.inscripcion_id, usuario_id: it.json._usuario_id, evento_id: it.json._evento_id,\n    accion: 'REASIGNAR', estado_anterior: 'LISTA_ESPERA', estado_nuevo: 'CONFIRMADA', fecha: it.json.fecha_actualizacion,\n    resultado: 'OK', detalle: `Promovido automáticamente (puesto ${it.json._orden_lista} en la lista)`,\n  },\n}));\n"
        },
        "id": "a70fb0e7-d17b-4b9a-b5b0-f5d7873f60ef",
