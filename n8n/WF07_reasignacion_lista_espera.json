      {
        "name": "Cupos libres por evento",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "const eventos = $('Eventos publicados').all().map(i => i.json).filter(e => e.evento_id);\nconst ins = ($input.first().json.inscripciones || []).filter(i => i.inscripcion_id);\nconst ahoraMs = Date.now();\nconst salida = [];\nfor (const e of eventos) {\n  const inicio = new Date(`${e.fecha}T${e.hora || '00:00'}:00-05:00`).getTime();\n  if (inicio <= ahoraMs) continue; // si ya empezo no se reasigna\n  const confirmados = ins.filter(i => i.evento_id === e.evento_id && (i.estado === 'CONFIRMADA' || i.estado === 'ASISTIO')).length; // los que ya asistieron siguen ocupando su cupo\n  const libres = Number(e.capacidad) - confirmados;\n  if (libres <= 0) continue;\n  ins.filter(i => i.evento_id === e.evento_id && i.estado === 'LISTA_ESPERA').forEach(i => {\n    salida.push({ json: { ...i, _libres: libres, _evento_nombre: e.nombre, _fecha: e.fecha, _hora: e.hora, _lugar: e.lugar } });\n  });\n}\nreturn salida; // si no hay nada que reasignar el flujo termina aqui\n"
        },
        "id": "a22dcc2f-cbb8-4a0e-8611-af3e6ca0fbeb",
        "position": [
          1440,
          0
        ]
      },
      {
        "name": "Ordenar por fecha_inscripcion ASC",
        "type": "n8n-nodes-base.sort",
        "typeVersion": 1,
        "parameters": {
          "sortFieldsUi": {
            "sortField": [
              {
                "fieldName": "fecha_inscripcion",
                "order": "ascending"
              }
            ]
          },
          "options": {}
        },
        "id": "d6e6fca4-b067-47d5-bb3d-d6b49df1e4a2",
        "position": [
          1680,
          0
        ]
      },
      {
        "name": "Elegir promovidos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "parameters": {
          "jsCode": "// ya vienen ordenados: el que lleva mas tiempo esperando primero\nconst usados = {};\nconst ahora = new Date(Date.now() - 5 * 3600 * 1000).toISOString().slice(0, 19) + '-05:00';\nconst out = [];\nlet orden = {};\nfor (const it of $input.all()) {\n  const i = it.json;\n  orden[i.evento_id] = (orden[i.evento_id] || 0) + 1;\n  usados[i.evento_id] = usados[i.evento_id] || 0;\n  if (usados[i.evento_id] >= i._libres) continue;\n  usados[i.evento_id]++;\n  out.push({\n    json: {\n      inscripcion_id: i.inscripcion_id,\n      estado: 'CONFIRMADA',\n      fecha_actualizacion: ahora,\n      orden_espera: '',\n      _usuario_id: i.usuario_id, _evento_id: i.evento_id, _orden_lista: orden[i.evento_id],\n      _evento_nombre: i._evento_nombre, _fecha: i._fecha, _hora: i._hora, _lugar: i._lugar,\n    },\n  });\n}\nreturn out;\n"
        },
        "id": "0a7c5e7a-9133-4e27-a292-16e458f1d897",
        "position": [
          1920,
          0
        ]
      },
